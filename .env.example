# Cloudflare Pages Functions runtime variables.
# Do not commit real credentials or private webhook URLs.

# Option A: send inquiries to a webhook, for example Make/Zapier/CRM.
INQUIRY_WEBHOOK_URL=

# Option B: send inquiries by email through Resend.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=neoplastpl@info.pl
INQUIRY_FROM_EMAIL=NeoPlasty <noreply@example.pl>

# Local/demo only. Do not enable in production if you need real delivery.
INQUIRY_LOG_ONLY=false
